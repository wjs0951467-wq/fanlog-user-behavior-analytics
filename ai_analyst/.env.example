# 복사해서 .env 로 만들고 값을 채우세요 (.env 는 절대 git에 올리지 말 것)
OPENAI_API_KEY=sk-...
# 사용할 OpenAI 모델명. 개발 중엔 저렴한 모델, 평가는 같은 모델로 통일하세요
FANLOG_MODEL=모델명을_적으세요

# 관리자 계정: profile_db.py 와 sql/01_readonly_role.sql 실행 전용
DATABASE_URL_ADMIN=postgresql+psycopg://postgres:비밀번호@localhost:5433/fanlog
# 읽기 전용 계정: 앱(FastAPI)은 이 계정만 사용
DATABASE_URL_RO=postgresql+psycopg://fanlog_ro:change_me@localhost:5433/fanlog
